# WordPress (Headless CMS)
# Your WordPress REST API base URL — e.g. https://cms.justafterwork.com/wp-json/wp/v2
# Leave blank to use built-in fallback data.
NEXT_PUBLIC_WP_API_URL=

# SMTP — server-side email sending for the contact form (Plesk / Exabytes)
SMTP_HOST=mail.justafterwork.com
SMTP_PORT=465
SMTP_USER=Jarrod@justafterwork.com
SMTP_PASS=your-smtp-password-here
CONTACT_TO_EMAIL=Jarrod@justafterwork.com
CONTACT_FROM_EMAIL="Just After Work <Jarrod@justafterwork.com>"

# Railway sets PORT automatically in production — do not set here
# PORT=3000
