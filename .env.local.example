# WordPress Headless CMS — Railway deployment
# Copy this file to .env.local for local development
WORDPRESS_API_URL=https://docker-image-production-ed6e.up.railway.app/wp-json/wp/v2

# Resend — server-side email sending for the contact form
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Railway sets PORT automatically in production — do not set here
# PORT=3000
